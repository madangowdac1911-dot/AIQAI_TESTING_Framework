# Copy this file to .env and fill in real values.
# Which environment to run against: dev | qa | uat
TEST_ENV=qa

# Browser settings
BROWSER=chromium
HEADLESS=true
# Fixed viewport for headless / firefox / webkit (WIDTHxHEIGHT)
VIEWPORT=1920x1080
# Headed chromium starts maximized; set to false to use VIEWPORT instead
MAXIMIZE=true

# ParaBank test user
APP_USERNAME=your_username
APP_PASSWORD=your_password
